{
  "permissions": {
    "allow": [
      "Bash(npm install)",
      "Bash(npm config delete:*)",
      "Bash(npm config list:*)",
      "Bash(timeout 5 npm run dev:*)",
      "Skill(frontend-design)",
      "WebSearch",
      "Bash(npm test:*)",
      "Skill(superpowers:executing-plans)",
      "Bash(cargo test:*)",
      "Bash(npm test)",
      "Skill(superpowers:brainstorming)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Skill(superpowers:systematic-debugging)",
      "Bash(npm run build:*)",
      "Bash(cargo build:*)",
      "Bash(cargo run:*)",
      "Bash(taskkill:*)",
      "Bash(netstat:*)",
      "Bash(findstr:*)",
      "Bash(cat:*)",
      "Skill(superpowers:writing-plans)",
      "Bash(target/release/solver_cli.exe:*)",
      "Bash(curl:*)",
      "Bash(tasklist:*)",
      "Bash(python:*)",
      "Bash(powershell:*)",
      "Bash(dir:*)",
      "Skill(superpowers:subagent-driven-development)",
      "Bash(npx tsc:*)",
      "Bash(npx vitest run:*)",
      "Bash(npx tsx:*)",
      "Bash(if not exist:*)",
      "Bash(npm run dev:*)",
      "Bash(git reset:*)",
      "Bash(npm run show-state:*)",
      "Bash(npm run set-task:*)",
      "Bash(npm run add-step:*)",
      "Bash(npm run track-file:*)",
      "Bash(npm run save-state:*)",
      "Bash(git clone:*)",
      "Bash(xargs:*)",
      "Bash(node:*)",
      "Bash(npm run session:*)",
      "Bash(npm run show-plan:*)",
      "Bash(powershell -ExecutionPolicy Bypass -File .claude/session-loader-wrapper.ps1*)",
      "Bash(.claude/session_start_hook.bat*)",
      "Bash(cmd /c .claude\\\\session_start_hook.bat*)",
      "Bash(powershell -ExecutionPolicy Bypass -File .claude/session_start_hook.ps1*)",
      "mcp__chrome-devtools__list_pages",
      "mcp__chrome-devtools__get_console_message",
      "mcp__chrome-devtools__list_network_requests",
      "mcp__chrome-devtools__get_network_request",
      "mcp__chrome-devtools__navigate_page",
      "mcp__chrome-devtools__take_snapshot",
      "mcp__chrome-devtools__click",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(Get-Content \"$env:USERPROFILE\\\\.claude\\\\logs\\\\*mcp*.log\" -Tail 100 -ErrorAction:SilentlyContinue)",
      "Bash(Select-Object:*)",
      "Bash(npx:*)",
      "mcp__github__create_branch"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "github"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File .claude/session_start_hook.ps1"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "^(?!/).+$",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/user-prompt-submit.cjs"
          }
        ]
      }
    ]
  }
}
